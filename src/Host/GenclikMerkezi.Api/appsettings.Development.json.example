{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "your-smtp-username@example.com",
    "Password": "your-smtp-password-or-app-password",
    "FromAddress": "no-reply@example.com",
    "FromName": "Gençlik Merkezi"
  },
  "Website": {
    "BotProtection": {
      "TurnstileSecretKey": "your-cloudflare-turnstile-secret-key",
      "AllowedHostnames": ["your-website-domain.com"]
    }
  }
}
