<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9f8c4d63-5741-4578-b7b5-39b5f5e2cf05</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageReference Include="Hangfire.Core" Version="1.8.15" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.15" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.15" />
    <!-- Pins a transitive dependency (brought in by Microsoft.AspNetCore.OpenApi 10.0.8) past
         GHSA-v5pm-xwqc-g5wc (stack overflow on a circular schema reference); same 2.x major, no API
         surface change for this project. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Pins a transitive dependency (brought in by Hangfire.Core/Hangfire.AspNetCore/
         Hangfire.SqlServer 1.8.15, which declare Newtonsoft.Json >= 11.0.1 with no upper bound) past
         GHSA-5crp-9r3c-p9vr (StackOverflow/high CPU-RAM DoS on deeply nested JSON). This is a major
         version jump (11.x -> 13.x) from the version Hangfire ships with, so it is covered by
         HangfireJobSerializationTests to confirm Hangfire's own job serialization still round-trips
         method/argument data correctly under 13.0.4. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

