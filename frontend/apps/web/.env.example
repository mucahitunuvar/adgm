# Sunucu tarafı (yalnız Next.js sunucusu okur, tarayıcıya sızmaz).
BACKEND_ORIGIN=http://localhost:5016

# Tarayıcıya gömülür - gizli değer OLMAMALI (FRONTEND-GUVENLIK.md §7). Faz 3 Koşu 1 madde 6:
# backend'in public medya/dosya yanıtlarında döndürdüğü gerçek host; CSP img-src ve bakım modu
# dışındaki statik varlık referanslarının kaynağı. Gerçek değer, dev backend'in
# appsettings.json > FileStorageSettings.PublicBaseUrl ayarıyla EŞLEŞMELİDİR - bu port BACKEND_ORIGIN
# ile aynı olmayabilir (bkz. FRONTEND-ACIK-MADDELER.md madde 16, doğrulanacak).
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:5016

# Faz 3 Koşu 3 (Turnstile) ve A6 (GA4) açık kararlar netleşince eklenecek; şimdilik yok.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
