# Backend origin (gelistirme). Next rewrites ve Vite proxy bu adrese yönlendirir.
BACKEND_ORIGIN=http://localhost:5016

# apps/web (Next.js) - sunucu tarafi okur, tarayiciya gitmez.
# apps/candidate, apps/employer, apps/admin (Vite) icin ayni deger VITE_ onekiyle.
VITE_BACKEND_ORIGIN=http://localhost:5016

# Yalniz acik bilgi buraya girer (NEXT_PUBLIC_ / VITE_ onekli). Gizli anahtar asla.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# VITE_TURNSTILE_SITE_KEY=
